# The module is reached only through index.php?fc=module&module=presta360connector&controller=api.
# Direct access to PHP and source files is denied.
<FilesMatch "\.(php|tpl|json|md|txt|sql|neon|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
